<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/routine_gate_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/task_paper"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:id="@+id/routine_gate_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/routine_gate_title"
            android:textColor="@color/task_ink"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/routine_gate_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/task_muted"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/routine_gate_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/routine_gate_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/routine_gate_hint"
            android:textColor="@color/task_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/routine_gate_work"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/routine_gate_work"
            android:textColor="@color/task_paper"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/routine_gate_continue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:textColor="@color/task_ink"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
