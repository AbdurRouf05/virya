<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/focus_block_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/task_paper"
    android:fitsSystemWindows="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:id="@+id/focus_block_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/focus_block_title"
        android:textColor="@color/task_ink"
        android:textSize="44sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/focus_block_app"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/task_warn"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/focus_block_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/task_muted"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/focus_block_extend"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/bg_task_widget"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/focus_block_extend"
        android:textColor="@color/task_ink"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/focus_block_close"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_focus_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/focus_block_close"
        android:textColor="@color/task_paper"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
